# =============================================
# Telegram Bot for Sanaei X-UI Panel
# Environment Variables - Copy to .env and fill
# =============================================

# ============ Telegram Bot ============
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ============ Server ============
DEBUG=False
HOST=0.0.0.0
PORT=8000
APP_PORT=8000

# ============ Database (PostgreSQL) ============
DB_HOST=postgres
DB_PORT=5432
DB_USER=telegram_bot
DB_PASSWORD=your-secure-db-password
DB_NAME=telegram_bot_db

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ============ Admin Panel ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-secret-session-key-change-this

# ============ X-UI Panel ============
XUI_URL=http://your-xui-panel.com:54321
XUI_USERNAME=admin
XUI_PASSWORD=admin
XUI_INBOUND_ID=2

# ============ Backup (Optional) ============
BACKUP_SCHEDULE=0 2 * * *