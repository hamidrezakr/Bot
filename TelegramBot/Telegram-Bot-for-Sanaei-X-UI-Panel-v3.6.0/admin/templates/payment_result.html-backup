{% extends "base.html" %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col text-center">
            {% if success %}
                <h1 class="page-title">✅ پرداخت موفق</h1>
            {% else %}
                <h1 class="page-title">❌ پرداخت ناموفق</h1>
            {% endif %}
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="glass-card">
                {% if success %}
                    <div class="text-center mb-4">
                        <i class="bi bi-check-circle-fill" style="font-size:4rem;color:#28a745;"></i>
                        <h4 class="mt-3">پرداخت با موفقیت انجام شد</h4>
                        <p class="text-muted">کد پیگیری: {{ ref_id }}</p>
                    </div>

                    <div class="settings-card">
                        <h5 class="mb-3"><i class="bi bi-info-circle"></i> اطلاعات سرویس</h5>
                        <div class="table-responsive">
                            <table class="table table-dark">
                                <tbody>
                                    <tr>
                                        <td style="width:40%;">📧 یوزرنیم</td>
                                        <td><code>{{ data.client_email }}</code></td>
                                    </tr>
                                    <tr>
                                        <td>🖥️ پنل</td>
                                        <td>{{ data.panel_name }}</td>
                                    </tr>
                                    <tr>
                                        <td>📦 حجم</td>
                                        <td>{{ data.volume }} GB</td>
                                    </tr>
                                    <tr>
                                        <td>⏰ مدت</td>
                                        <td>{{ data.duration }} روز</td>
                                    </tr>
                                    {% if data.sub_url %}
                                    <tr>
                                        <td>🔗 لینک سابسکریپشن</td>
                                        <td><code>{{ data.sub_url }}</code></td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="https://t.me/SpaceGateVPN/705" class="btn-primary-glass" style="text-decoration:none;">
                            📖 راهنمای نصب
                        </a>
                    </div>
                {% else %}
                    <div class="text-center mb-4">
                        <i class="bi bi-x-circle-fill" style="font-size:4rem;color:#dc3545;"></i>
                        <h4 class="mt-3">{{ message }}</h4>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
